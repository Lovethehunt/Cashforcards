# Set these in Vercel → Project → Settings → Environment Variables.

# Added automatically when you connect a Vercel Blob store:
BLOB_READ_WRITE_TOKEN=

# Added automatically when you connect a Neon (Postgres) database:
DATABASE_URL=

# Password for /admin (pick a long one):
ADMIN_PASSWORD=

# Email alerts via Resend (resend.com — free tier is fine):
RESEND_API_KEY=
# Where new-submission alerts go:
NOTIFY_EMAIL=
# Sender. Use onboarding@resend.dev until cashforcards.app is verified in Resend,
# then something like: Cash for Cards <offers@cashforcards.app>
FROM_EMAIL=onboarding@resend.dev
# Set to "true" once your domain is verified in Resend to email sellers a receipt:
SEND_SELLER_CONFIRMATION=false
